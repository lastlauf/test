# Postgres connection string. Any Postgres works — a local one for development,
# a hosted one (Supabase, Neon, RDS) in production. Use a pooled connection
# string when deploying to serverless platforms such as Vercel.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/tsi

# Optional: enable "Sign in with Google". Leave unset for username accounts only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used to build the Google OAuth redirect URI.
APP_ORIGIN=http://localhost:3000

# Optional: set to enable POST /api/admin/seed, which resets a demo deployment
# to the seeded tournament. Callers must send it as the x-seed-token header.
TSI_SEED_TOKEN=
